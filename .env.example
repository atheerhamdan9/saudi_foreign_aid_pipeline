# Saudi Foreign Aid Data Pipeline

# Local data paths
# Source CSV files: data/raw/source_a/
# Processed data: data/processed/
# Output files: data/output/

# Google Cloud configuration
GCP_PROJECT_ID=saudi-foreign-aid-data
GCS_RAW_BUCKET=saudi-foreign-aid-raw-data
BQ_RAW_DATASET=saudi_aid_raw
BQ_DBT_DATASET=saudi_aid_dbt_dev
GCP_REGION=europe-west1

# Authentication
# Local development uses Google Application Default Credentials / OAuth.
# Do not commit service account keys or credentials.
SERVICE_ACCOUNT_EMAIL=saudi-aid-pipeline-sa@saudi-foreign-aid-data.iam.gserviceaccount.com

