# Stage 1: Install runtime dependencies
FROM python:3.12-slim AS builder

WORKDIR /build

RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir \
    "streamlit>=1.65,<2.0" \
    "google-cloud-bigquery>=3.25,<4.0" \
    "pandas>=2.2,<3.0" \
    "plotly>=7.1,<8.0" \
    "pycountry>=26.2.16,<27.0.0" \
    "babel>=2.18,<3.0"

# Stage 2: Minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY dashboard/ /app/dashboard/
COPY .streamlit/ /app/.streamlit/

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "exec streamlit run dashboard/app.py --server.address=0.0.0.0 --server.port=${PORT} --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=true"]
